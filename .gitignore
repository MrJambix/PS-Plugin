# Only the plugins' source and the tools go to GitHub. Everything else in this
# folder stays on this PC: the loader (.exe, license, user, assets), its own
# scripts, the API stubs, saved game data (scripts_data, wow_settings.dat) and
# built zips.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/scripts/
!/tools/

/scripts/*
!/scripts/jcore/
!/scripts/jambix_aio/
!/scripts/jambix_market/
!/scripts/jambix_debug/

/tools/jtest/node_modules/
/tools/jtest/out/
/tools/jcheck/node_modules/
*.zip
*.tmp
